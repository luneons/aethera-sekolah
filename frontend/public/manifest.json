{
  "id": "/?source=pwa",
  "name": "Aethera — Platform Sekolah Modern",
  "short_name": "Aethera",
  "description": "Platform manajemen sekolah modern: absensi pengenalan wajah, disiplin, gamifikasi, papan peringkat, materi & nilai, chat, dan notifikasi terintegrasi dalam satu aplikasi.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#050a0f",
  "theme_color": "#050a0f",
  "lang": "id",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "categories": ["education", "productivity", "business"],
