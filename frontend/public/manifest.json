  "screenshots": [
    {
      "src": "/icons/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Aethera — Dashboard mobile"
    },
    {
      "src": "/icons/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Aethera — Dashboard kepala sekolah"
    }
  ],
  "shortcuts": [
    {
      "name": "Scan Wajah",
      "short_name": "Scan",
      "description": "Buka mode kiosk scan wajah",
      "url": "/scan",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Lihat statistik kehadiran hari ini",
      "url": "/dashboard",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Notifikasi",
      "short_name": "Notif",
      "description": "Lihat notifikasi terbaru",
      "url": "/notifications",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Chat",
      "short_name": "Chat",
      "description": "Buka pesan",
      "url": "/chat",
      "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/chat",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+aethera",
      "url": "/?ref=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/gradebook",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"]
      },
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ],
  "tab_strip": {
    "home_tab": {
      "scope_patterns": [
        { "pathname": "/dashboard" }
      ]
    },
    "new_tab_button": {
      "url": "/dashboard"
    }
  },
  "related_applications": []
}
