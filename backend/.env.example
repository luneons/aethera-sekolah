APP_NAME=Aethera
APP_ENV=production
SECRET_KEY=GANTI_DENGAN_RANDOM_STRING_PANJANG_32_KARAKTER
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database MySQL — ganti DB_USER & DB_PASSWORD sesuai kredensial.
# Kalau password mengandung karakter spesial (! @ # %), URL-encode dulu (mis. "!" jadi "%21").
DATABASE_URL=mysql+aiomysql://DB_USER:DB_PASSWORD@localhost:3306/aethera

# CORS — pisahkan dengan koma. Untuk PWA Android subdomain wajib di-include.
CORS_ORIGINS=https://aethera.my.id,http://localhost:3000

# Face recognition
FACE_MATCH_THRESHOLD=0.45
FACE_MIN_QUALITY=0.4
SNAPSHOT_DIR=./storage/snapshots
# 32-byte string untuk derive AES-256-GCM key (di-hash SHA-256 ke 32 byte)
EMBEDDING_ENCRYPTION_KEY=GANTI_DENGAN_32_KARAKTER_RANDOM_PRODUCTION

# Geofencing BYOD (atur sesuai lokasi sekolah)
GEOFENCE_ENABLED=false
OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_RADIUS_METERS=150
GEOFENCE_MAX_ACCURACY_METERS=150

# Web Push VAPID — generate dengan `python _gen_vapid.py`
# Setelah ganti VAPID_PUBLIC_KEY semua user harus re-subscribe push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# OpenRouter (AI Insight) — gratis pakai model Nemotron Nano.
# Dapatkan API key di https://openrouter.ai/keys (gratis dengan rate limit harian).
# Kalau dikosongkan, AI Insight pakai fallback rule-based (tetap berfungsi).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_REFERER=https://yourdomain.com
OPENROUTER_APP_NAME=Aethera

# ── Midtrans Payment Gateway ─────────────────────────────────────────────────
# Dapatkan key di https://dashboard.midtrans.com → Settings → Access Keys.
# Saat development pakai key Sandbox (prefix SB-Mid-...). Produksi pakai key live.
# Kalau dikosongkan, tombol "Bayar Online" tidak muncul (fallback ke pembayaran manual).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_FINISH_URL=https://yourdomain.com/my-bills
